{
  "files": [],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ui/*": [
        "./src/components/ui/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@/*": [
        "./src/*"
      ],
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
